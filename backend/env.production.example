# Copy this file to backend/.env.production on the server and fill in real
# values. .env.production is gitignored - never commit real secrets.

ENVIRONMENT=production

# The "db" hostname below is the Postgres service name in docker-compose.yml -
# leave it as "db", only change the password to match POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg2://hangugeo:REPLACE_WITH_POSTGRES_PASSWORD@db:5432/hangugeo

# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Your real domain or server IP, e.g. ["https://hangugeo.example.com"]
CORS_ALLOW_ORIGINS=["http://REPLACE_WITH_YOUR_SERVER_IP_OR_DOMAIN"]
